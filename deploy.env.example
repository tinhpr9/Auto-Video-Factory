# Required for AI mode. Keep these as platform/server secrets; never commit real values.
AVF_PROVIDER=openai
OPENAI_API_KEY=
AVF_ACCESS_CODE=

# Safe defaults for a private single-user deployment.
AVF_MAX_WORKERS=1
AVF_MAX_JOBS_PER_HOUR=12
AVF_AUTH_ATTEMPTS_PER_MINUTE=5
AVF_SESSION_TTL_SECONDS=43200
AVF_OUTPUT_ROOT=/data/output

# Most hosts inject PORT automatically. Set AVF_PORT only when your host requires it.
# AVF_PORT=8000
